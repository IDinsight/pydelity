# direnv: load .env, then the env file for PROJECT_ENV, whose values override it.
# PROJECT_ENV is local, development or production, and defaults to local. To use
# another without editing this file: `export PROJECT_ENV=production && direnv reload`.
export PROJECT_ENV="${PROJECT_ENV:-local}"

# Map PROJECT_ENV to file.
case "$PROJECT_ENV" in
  local)       ENV_FILE=".env.local" ;;
  development) ENV_FILE=".env.development" ;;
  production)  ENV_FILE=".env.production" ;;
  *)
    echo "✖ Invalid PROJECT_ENV='$PROJECT_ENV'. Use: local | development | production." >&2
    exit 1
    ;;
esac

# [OPTIONAL] Load .env first if it exists so that environment-specific values can
# override it.
dotenv_if_exists .env

# Load the selected file. A missing file is only a warning: installing and testing the
# project need no environment variables.
if [[ -f "$ENV_FILE" ]]; then
  dotenv "$ENV_FILE"
  echo "✔ Loaded $ENV_FILE (PROJECT_ENV='$PROJECT_ENV')"
else
  echo "⚠ $ENV_FILE not found; continuing without it (PROJECT_ENV='$PROJECT_ENV')." >&2
fi
