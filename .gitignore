# Files and folders git ignores in this repo.

# Environments
.env*
*.env*
!.envrc
!.template.env*
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# MacOS system files
.DS_Store

# Misc.
caches/
data/
graveyard/
logs/
pydelity-output/
results/
secrets/

# PyCharm
# JetBrains specific template is maintained in a separate JetBrains.gitignore that can
# be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
# and can be added to the global gitignore or merged into this file. For a more nuclear
# option (not recommended) you can uncomment the following to ignore the entire idea
# folder.
.idea/

# Python bytecode and native extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Python build and distribution output
.eggs/
*.egg
*.egg-info/
build/
dist/
MANIFEST
wheels/

# Python tool caches and reports
.cache
.coverage
.coverage.*
.dmypy.json
.hypothesis/
.mypy_cache/
.nox/
.pytest_cache/
.ruff_cache/
.tox/
coverage.xml
dmypy.json
htmlcov/

# Docs site (Astro): installed packages, build output and generated types
docs/.astro/
docs/dist/
docs/node_modules/

# Sphinx documentation
docs/_build/

# VS Code
.vscode/
